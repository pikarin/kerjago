<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!-- Real-browser end-to-end tests. Last, so the fast suites report
             first, and excluded from the default run by `php artisan test`
             through the `e2e` group below. -->
        <testsuite name="Browser">
            <directory>tests/Browser</directory>
        </testsuite>
    </testsuites>
    <!-- The `e2e` group is applied to tests/Browser in tests/Pest.php. Run the
         browser tests with `php artisan test` and an explicit `group=e2e`
         option, which overrides this exclusion. -->
    <groups>
        <exclude>
            <group>e2e</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- Filament pushes a test run past PHP's 128M default, most visibly
             when blade-ui-kit/blade-icons rebuilds its manifest after a cache
             clear. See docs/adr/0011. -->
        <ini name="memory_limit" value="1G"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <!-- Reverb, not null: the null broadcaster authorizes every channel,
             which would make channel authorization tests pass vacuously. No
             Reverb server is needed — /broadcasting/auth is plain HTTP. -->
        <env name="BROADCAST_CONNECTION" value="reverb"/>
        <env name="REVERB_APP_ID" value="testing"/>
        <env name="REVERB_APP_KEY" value="testing-key"/>
        <env name="REVERB_APP_SECRET" value="testing-secret"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="kerjago_test"/>
        <env name="DB_URL" value=""/>
        <env name="SCOUT_DRIVER" value="null"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
